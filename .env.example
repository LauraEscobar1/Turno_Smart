# Copia este archivo como .env y reemplaza los valores de ejemplo.
# Solo van aquí variables PÚBLICAS: todo lo que empieza por EXPO_PUBLIC_ se incrusta
# en el bundle de la app y cualquier persona puede leerlo.
#
# ⚠️ NUNCA pongas aquí DEEPSEEK_API_KEY ni SUPABASE_SERVICE_ROLE_KEY (service role).
#    Son secretos del servidor: se configuran como secretos de las Edge Functions
#    con `supabase secrets set` (Fase 3 y Fase 5), nunca en la app.

# URL del proyecto de Supabase (Dashboard → Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anónima (pública). La seguridad real la dan las políticas RLS.
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica
